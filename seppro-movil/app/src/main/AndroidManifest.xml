<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Red: toda la comunicación con Supabase es HTTPS -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bluetooth LE en Android 12+ (API 31+). Sin neverForLocation: el sensor
         (Smart Tag) puede anunciarse como beacon y no queremos que se filtre -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Ubicación precisa: requerida para escanear BLE hasta Android 11
         y, al no usar neverForLocation, también en Android 12+ -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+ exige pedir COARSE junto con FINE (si no, ignora la petición) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Permisos legados de Bluetooth, solo hasta Android 11 (API 30) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- BLE opcional: la app se instala aunque el teléfono no lo tenga -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reglas_respaldo"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/seguridad_red"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="SEPPRO"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
        tools:targetApi="34">

        <!-- Login nativo contra Supabase -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="SEPPRO">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla principal: Toolbar + BottomNavigationView con 4 pestañas -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="SEPPRO" />

        <!-- Práctica 7: módulo de Soporte (reportes y chat en tiempo real) -->
        <activity
            android:name=".NuevoReporteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReporteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>
</manifest>
