<?xml version="1.0" encoding="utf-8"?>
<!-- Seguridad: solo HTTPS (sin tráfico en claro) y solo certificados del sistema -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
