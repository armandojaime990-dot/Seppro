<?xml version="1.0" encoding="utf-8"?>
<!-- Seguridad: no se respaldan ni transfieren las preferencias (correo, último sensor) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
